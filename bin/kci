#!/usr/bin/env bash

COLOR_RESET="\\033[0m"
COLOR_YELLOW="\\033[33m"
#COLOR_GREEN="\\033[32m"
COLOR_RED="\\033[31m"
#COLOR_MAGENTA="\\033[35m"
COLOR_BOLD="\\e[1m"

if [ $# -eq 0 ]; then
	echo
	echo -e "$COLOR_YELLOW Please at list add a commit message ;) $COLOR_RESET"
	echo
	exit 1
fi

MESSAGE=$1
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
TICKET=$(echo "$BRANCH_NAME" | grep -oE '^(NO-REF|CALS-[0-9]+)')
BRANCH_TYPE=$(echo "$BRANCH_NAME"| awk -F'-' '{print $3}')
TYPE=${2:-"$BRANCH_TYPE"}
SCOPE=$(echo "$BRANCH_NAME" | awk -F'-' '{print $4}')

# shift 2
# ARGS_REST=("$@")
# shellcheck disable=SC2116
TYPES=$(echo build chore ci docs feat fix perf refactor revert style test)

if [[ ! ${TYPES[*]} =~ "${TYPE}"( |$) ]]; then
	echo
	echo -e "$COLOR_RED \xE2\x9D\x8C ${COLOR_RESET}Type: ${COLOR_YELLOW}${COLOR_BOLD}${TYPE}${COLOR_RESET} is invalid, must be one of:"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW build${COLOR_RESET}: Changes that affect the build system or external dependencies (example scopes${COLOR_RESET}: gulp, broccoli, npm)"

    echo -e "    -$COLOR_BOLD$COLOR_YELLOW chore${COLOR_RESET}: Changes to the build process or auxiliary tools and libraries such as documentation generation ${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW ci${COLOR_RESET}: Changes to our CI configuration files and scripts (example scopes${COLOR_RESET}: Travis, Circle, BrowserStack, SauceLabs)"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW docs${COLOR_RESET}: Documentation only changes"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW feat${COLOR_RESET}: A new feature"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW fix${COLOR_RESET}: A bug fix"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW perf${COLOR_RESET}: A code change that improves performance"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW refactor${COLOR_RESET}: A code change that neither fixes a bug nor adds a feature"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW revert${COLOR_RESET}: A code change that revert a change"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW style${COLOR_RESET}: Changes that do not affect the meaning of the code (white-space, formatting, missing semi-colons, etc)"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW test${COLOR_RESET}: Adding missing tests or correcting existing tests"
	echo
	exit 1
fi

#PACKAGES=$(git diff --name-only --cached \
    #| grep -E "^(packages|apps)/" \
    #| sed -e 's/\(packages\|apps\)\/\([^\/]*\)\/.*$/\2/g' \
	#| sort \
	#| uniq \
	#| tr '\n' ',' \
	#| sed -e 's/,$//g'
#)
## TODO improve this reg exp

SCOPES=$(echo admin agency arrangement auth cdc cms core deps ds eli fei forms messaging routing sdk translation ui)

if [[ ! ${SCOPES[*]} =~ "${SCOPE}"( |$) ]]; then
	echo
	echo -e "$COLOR_RED \xE2\x9D\x8C ${COLOR_RESET}Scope: ${COLOR_YELLOW}${COLOR_BOLD}${SCOPE}${COLOR_RESET} is invalid, must be one of:"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW admin${COLOR_RESET}"

    echo -e "    -$COLOR_BOLD$COLOR_YELLOW agency${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW arrangement${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW auth${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW cdc${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW cms${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW core${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW deps${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW ds${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW eli${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW fei${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW forms${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW messaging${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW routing${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW sdk${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW translation${COLOR_RESET}"
    echo -e "    -$COLOR_BOLD$COLOR_YELLOW ui${COLOR_RESET}"
	echo
	exit 1
fi


SCOPE_MESSAGE=$([ -n "$SCOPE" ] && echo "($SCOPE)" || echo "");


COMMIT_MESSAGE="$TYPE$SCOPE_MESSAGE: $TICKET $MESSAGE"

# we remove first args from all args
shift 1
shift 1
git commit -m "$COMMIT_MESSAGE" "${@}"
# git commit -m "$COMMIT_MESSAGE"
